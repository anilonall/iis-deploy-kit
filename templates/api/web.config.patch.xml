<?xml version="1.0" encoding="utf-8"?>
<!--
  Elements that build-package.ps1 merges into the API's published web.config
  (configuration/location/system.webServer or configuration/system.webServer).
  Existing <security> and <httpProtocol> elements are replaced by these.

  build-package.ps1 also sets on the <aspNetCore> element:
    hostingModel="inprocess"   the app runs inside w3wp.exe: no extra Kestrel port, no proxy hop,
                               the real client IP and the https scheme arrive directly
    stdoutLogEnabled="false"   ANCM stdout logs are never rotated and fill the disk; enable them
                               temporarily on the server only to diagnose a 500.30
    stdoutLogFile=<root>\logs\stdout\api   (folder exists, the API pool may write there)
    shutdownTimeLimit="30"     seconds for background services to stop gracefully

  Placeholder replaced at build time:
    __MAX_REQUEST_BYTES__      server.maxRequestBodyMb from deploy.config.json, in bytes
                               (larger requests get IIS 404.13 before reaching the app)
-->
<root>
  <security>
    <requestFiltering removeServerHeader="true">
      <requestLimits maxAllowedContentLength="__MAX_REQUEST_BYTES__" />
    </requestFiltering>
  </security>
  <httpProtocol>
    <customHeaders>
      <remove name="X-Powered-By" />
      <remove name="X-Content-Type-Options" />
      <add name="X-Content-Type-Options" value="nosniff" />
      <remove name="X-Frame-Options" />
      <add name="X-Frame-Options" value="DENY" />
      <remove name="Referrer-Policy" />
      <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      <remove name="Strict-Transport-Security" />
      <add name="Strict-Transport-Security" value="max-age=31536000" />
    </customHeaders>
  </httpProtocol>
</root>
