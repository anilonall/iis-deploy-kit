<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 10 configuration for a single-page application (React/Vite or any static build).

  How it is used
    * Put a copy in your frontend's public/ folder (Vite copies it to dist/web.config), or leave
      it out and build-package.ps1 uses this template.
    * build-package.ps1 replaces the placeholders below in the PACKAGED copy:
        __WEB_HOST__        canonical web host from deploy.config.json (domains.web), e.g. example.com
        __WEB_HOST_REGEX__  the same host, regex-escaped (example\.com)
        __API_ORIGIN__      https://<domains.api>, e.g. https://api.example.com
    * Requires IIS URL Rewrite 2.1 (setup-server.ps1 installs it). Without it the site
      returns HTTP 500.19.

  HTTP-only mode
    While the web site has no HTTPS binding yet (certificate not issued), install-release.ps1
    disables the "canonical-host" rule and removes HSTS and upgrade-insecure-requests from the
    INSTALLED copy, otherwise visitors would be redirected to a non-working https:// address.
    After win-acme has added the certificate, re-install the same package (-Component Web).
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <clear />
        <!-- 1) Let's Encrypt HTTP-01 challenge path: never redirected, never rewritten to the SPA. -->
        <rule name="acme-challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <!-- 2) Hidden files (.env, .git, .htaccess, ...) are never served. Other /.well-known/
                files (assetlinks.json, apple-app-site-association, ...) are served normally. -->
        <rule name="hidden-files" stopProcessing="true">
          <match url="(^|/)\." />
          <conditions>
            <add input="{URL}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <!-- 3) HTTP -> HTTPS and any alias (www.example.com) -> canonical host, in ONE permanent
                redirect. Disabled automatically while the site has no certificate. -->
        <rule name="canonical-host" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^__WEB_HOST_REGEX__$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://__WEB_HOST__/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <!-- 4) "/" is processed as /index.html so the no-cache rule below also applies to it. -->
        <rule name="root-document" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        <!-- 5) SPA fallback: anything that is not a real file or folder is served index.html so
                client-side routes survive a page refresh. Missing files under /assets/,
                /.well-known/, robots.txt and sitemap.xml are a real 404 (a stale hashed bundle
                must not be answered with HTML, the browser would show a blank page). -->
        <rule name="spa-fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="^/(assets|\.well-known)/" negate="true" />
            <add input="{URL}" pattern="^/(robots\.txt|sitemap\.xml)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Remove first: a duplicate mimeMap (already defined at server level) is a 500.19. -->
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <!-- Default cache for root files (favicon, robots.txt, ...): one day. /assets/ and
           index.html have their own rules in the <location> sections below. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" cacheControlCustom="public" />
    </staticContent>

    <!-- Static compression only (types are configured at server level by setup-server.ps1). -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Static site: read-only requests, no request body needed. -->
        <requestLimits maxAllowedContentLength="1048576" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), geolocation=(), microphone=(), payment=(), usb=()" />
        <!-- HSTS for this host only. includeSubDomains is deliberately NOT set: it would also force
             HTTPS on every other subdomain (mail, autodiscover, legacy hosts). Browsers ignore
             HSTS received over plain HTTP. -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <!-- Content Security Policy. Adjust to what your SPA really loads:
               connect-src  the API origin (build-package.ps1 checks that it is present)
               style-src    'unsafe-inline' is common for UI libraries; remove it if you can
               img-src      add map tile / CDN hosts here
               font-src     add e.g. https://fonts.gstatic.com when using Google Fonts -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' __API_ORIGIN__; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Build output with content hashes in the file names: cache for one year, immutable. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- index.html is always revalidated so a new release is picked up immediately. "/" and SPA
       routes are rewritten to index.html, so this applies to them as well. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" cacheControlCustom="must-revalidate" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- File-based ACME validation (win-acme defaults to its own listener, so this is a fallback):
       extension-less challenge files are served as plain text. -->
  <location path=".well-known/acme-challenge">
    <system.webServer>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
